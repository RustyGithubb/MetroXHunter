msgctxt ",FC521F04417D24BE0F3E5BA629665017"
msgid "to fire electrics arcs"
msgstr "pour projetter des arcs électriques"

#. Key:	30F465554CCF560D9ECF91BF115830E9
#. SourceLocation:	/Game/Design/Widgets/Tutorial/WBP_Tutorial_Switch_Mode.WBP_Tutorial_Switch_Mode_C:WidgetTree.CommonTextBlock_1.Text
#: /Game/Design/Widgets/Tutorial/WBP_Tutorial_Switch_Mode.WBP_Tutorial_Switch_Mode_C:WidgetTree.CommonTextBlock_1.Text
