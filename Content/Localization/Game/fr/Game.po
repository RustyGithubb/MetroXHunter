msgctxt ",FE1AACFD453E95C450595DBF92712D24"
msgid "to shoot"
msgstr "pour tirer"

#. Key:	AF8431624B9680B773A7BDACB0B264AB
#. SourceLocation:	/Game/Design/Widgets/Tutorial/WBP_Tutorial_Shoot.WBP_Tutorial_Shoot_C:WidgetTree.CommonTextBlock_4.Text
