msgctxt ",AF8431624B9680B773A7BDACB0B264AB"
msgid "Hold"
msgstr "Maintenir"

#. Key:	FC521F04417D24BE0F3E5BA629665017
#. SourceLocation:	/Game/Design/Widgets/Tutorial/WBP_Tutorial_Switch_Mode.WBP_Tutorial_Switch_Mode_C:WidgetTree.CommonTextBlock.Text
